<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.branchteller</groupId>
  <artifactId>branch-teller-pos</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <allure.version>2.29.0</allure.version>
    <cucumber.version>7.18.1</cucumber.version>
    <junit-platform-suite.version>1.10.2</junit-platform-suite.version>
    <!-- QA finding (fixed): this used to be hardcoded directly as a literal string inside
         maven-surefire-plugin's <configuration><excludedGroups> below. In JUnit5 tag
         filtering, an excluded tag always wins over an included one, so as long as that
         literal was present, `mvn test -Dgroups=desktop-automation` (the exact command this
         project's own README and LoginDesktopTest/HelpDesktopTest javadocs instruct people to
         run) could never actually run a single desktop-automation test; it silently printed
         "Tests run: 0" instead of running or reporting an error, so the gap was easy to miss.
         Same problem for -Dgroups=web-automation. Moving the value into this property and
         referencing ${excludedGroups} below keeps the default `mvn verify`/`mvn test` behavior
         identical (both opt-in groups still excluded by default), while letting the command
         line actually override it, e.g.:
           mvn test -DexcludedGroups= -Dgroups=desktop-automation -Dtest=HelpDesktopTest -->
    <excludedGroups>web-automation,desktop-automation</excludedGroups>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>9.7.0</version>
    </dependency>

    <!-- Test-only dependencies: JUnit 5 for unit tests, H2 as an in-memory stand-in
         for MySQL so DAO/service tests that need a real Connection don't require a
         live MySQL server, Mockito for mocking collaborators. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.2.224</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>5.11.0</version>
      <scope>test</scope>
    </dependency>

    <!-- Allure JUnit5 reporting -->
    <dependency>
      <groupId>io.qameta.allure</groupId>
      <artifactId>allure-junit5</artifactId>
      <version>${allure.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Allure adapter for Cucumber scenario reporting -->
    <dependency>
      <groupId>io.qameta.allure</groupId>
      <artifactId>allure-cucumber7-jvm</artifactId>
      <version>${allure.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Cucumber BDD: feature files under src/test/resources/features, run through
         the JUnit Platform Suite engine (see cucumber/RunCucumberTest.java) so `mvn test`
         picks up scenarios alongside ordinary @Test methods in one build. -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <version>${cucumber.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit-platform-engine</artifactId>
      <version>${cucumber.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite</artifactId>
      <version>${junit-platform-suite.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- ===== Test automation suite (see src/test/java/com/branchteller/automation) =====
         Three independent layers, each demonstrating a different automation discipline:
           1) REST API automation (RestAssured):      @Tag("api-automation"), runs by default
           2) Web UI automation (Selenium + POM):      @Tag("web-automation"), opt-in (needs
              the React dev server + a real browser; see README "Test Automation" section)
           3) Desktop UI automation (AssertJ-Swing):   @Tag("desktop-automation"), opt-in
              (needs a display; use xvfb-run on headless Linux)
         The excludedGroups in maven-surefire-plugin below keeps (2) and (3) out of the
         default `mvn verify` / CI run so the pipeline doesn't need a browser or a display. -->
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <version>5.4.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.hamcrest</groupId>
      <artifactId>hamcrest</artifactId>
      <version>2.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>4.21.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Auto-downloads/manages the matching chromedriver binary for whatever Chrome
           version is installed, so nobody has to hand-manage a chromedriver.exe on PATH. -->
      <groupId>io.github.bonigarcia</groupId>
      <artifactId>webdrivermanager</artifactId>
      <version>5.8.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Core (framework-agnostic) artifact: deliberately not assertj-swing-junit,
           which pulls in a JUnit4 runner this JUnit5-only project doesn't use. -->
      <groupId>org.assertj</groupId>
      <artifactId>assertj-swing</artifactId>
      <version>3.17.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>branch-teller-pos</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.branchteller.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <!-- Points DBConnection (which reads DB_URL/DB_USER/DB_PASSWORD from the
               environment) at a single named, DB_CLOSE_DELAY=-1 H2 in-memory database
               for the whole test JVM. Every service that calls DBConnection.getConnection()
               internally (BankingService, CustomerService, ApprovalService, InterestService,
               AmlService's read methods) therefore talks to this same schema during tests,
               with zero code changes to the production classes. API_PORT is likewise
               overridden so ApiServerIntegrationTest doesn't collide with a real instance
               a developer might have running locally on 8082. See support/TestDatabase.java
               for the schema this URL is expected to hold. -->
          <environmentVariables>
            <DB_URL>jdbc:h2:mem:branchteller_test;DB_CLOSE_DELAY=-1</DB_URL>
            <DB_USER>sa</DB_USER>
            <DB_PASSWORD></DB_PASSWORD>
            <API_PORT>18082</API_PORT>
          </environmentVariables>
          <systemPropertyVariables>
            <!-- Lets Allure's JUnit5 extension register itself via ServiceLoader without
                 needing @ExtendWith on every test class. -->
            <junit.jupiter.extensions.autodetection.enabled>true</junit.jupiter.extensions.autodetection.enabled>
            <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
          </systemPropertyVariables>
          <!-- web-automation (Selenium) and desktop-automation (AssertJ-Swing) need a real
               browser / display and are excluded from the default run; api-automation
               (RestAssured) needs neither, so it runs alongside the rest of the suite.
               Value comes from the ${excludedGroups} property above (not hardcoded here)
               specifically so it can be overridden from the command line; see that
               property's javadoc-style comment for the bug this fixes and the working
               command; see README for the full opt-in instructions. -->
          <excludedGroups>${excludedGroups}</excludedGroups>
        </configuration>
      </plugin>

      <!-- `mvn io.qameta.allure:allure-maven:report` (or `mvn allure:report` once this
           plugin is resolved) turns target/allure-results (written by the JUnit5 and
           Cucumber Allure adapters above) into a browsable HTML report under
           target/site/allure-maven-plugin. -->
      <plugin>
        <groupId>io.qameta.allure</groupId>
        <artifactId>allure-maven</artifactId>
        <version>2.15.2</version>
        <configuration>
          <reportVersion>${allure.version}</reportVersion>
        </configuration>
      </plugin>

      <!-- Lets `mvn exec:java -Dexec.mainClass=...` run the Swing app or the ApiServer
           straight off Maven's dependency-resolved classpath (mysql-connector-j included),
           so run_app.bat / run_api_server.bat don't need a hand-copied driver jar under lib/. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
      </plugin>
    </plugins>
  </build>
</project>
